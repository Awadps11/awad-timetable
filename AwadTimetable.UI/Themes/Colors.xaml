<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ألوان الثيم الفاتح (افتراضي) -->
    <Color x:Key="PrimaryColor">#2563EB</Color>
    <Color x:Key="PrimaryHover">#1D4ED8</Color>
    <Color x:Key="PrimaryLight">#DBEAFE</Color>
    <Color x:Key="PrimaryDark">#1E40AF</Color>
    
    <Color x:Key="SecondaryColor">#059669</Color>
    <Color x:Key="SecondaryHover">#047857</Color>
    <Color x:Key="SecondaryLight">#D1FAE5</Color>
    
    <Color x:Key="SurfaceColor">#FAFAFA</Color>
    <Color x:Key="SurfaceVariant">#F5F5F5</Color>
    <Color x:Key="BackgroundColor">#FCFCFC</Color>
    <Color x:Key="OnSurface">#1C1C1C</Color>
    <Color x:Key="OnSurfaceVariant">#4A4A4A</Color>
    <Color x:Key="OutlineColor">#E0E0E0</Color>
    
    <Color x:Key="ErrorColor">#DC2626</Color>
    <Color x:Key="ErrorLight">#FEF2F2</Color>
    <Color x:Key="WarningColor">#D97706</Color>
    <Color x:Key="WarningLight">#FFFBEB</Color>
    <Color x:Key="SuccessColor">#059669</Color>
    <Color x:Key="SuccessLight">#ECFDF5</Color>
    <Color x:Key="InfoColor">#2563EB</Color>
    <Color x:Key="InfoLight">#DBEAFE</Color>

    <!-- ألوان المواد الدراسية -->
    <Color x:Key="SubjectMath">#2563EB</Color>
    <Color x:Key="SubjectScience">#059669</Color>
    <Color x:Key="SubjectLanguage">#7C3AED</Color>
    <Color x:Key="SubjectHistory">#D97706</Color>
    <Color x:Key="SubjectArt">#EC4899</Color>
    <Color x:Key="SubjectPE">#0891B2</Color>
    <Color x:Key="SubjectComputer">#7C3AED</Color>
    <Color x:Key="SubjectReligion">#D97706</Color>
    <Color x:Key="SubjectSocial">#059669</Color>

    <!-- Thème sombre -->
    <Color x:Key="DarkPrimaryColor">#60A5FA</Color>
    <Color x:Key="DarkPrimaryHover">#93C5FD</Color>
    <Color x:Key="DarkPrimaryLight">#1E3A5F</Color>
    <Color x:Key="DarkSecondaryColor">#34D399</Color>
    <Color x:Key="DarkSurfaceColor">#1E1E1E</Color>
    <Color x:Key="DarkSurfaceVariant">#2D2D2D</Color>
    <Color x:Key="DarkBackgroundColor">#121212</Color>
    <Color x:Key="DarkOnSurface">#E8E8E8</Color>
    <Color x:Key="DarkOnSurfaceVariant">#A0A0A0</Color>
    <Color x:Key="DarkOutlineColor">#404040</Color>
    <Color x:Key="DarkErrorColor">#EF4444</Color>
    <Color x:Key="DarkWarningColor">#FBBF24</Color>
    <Color x:Key="DarkSuccessColor">#22C55E</Color>

    <!-- High Contrast Theme -->
    <Color x:Key="HCPrimary">#FFFF00</Color>
    <Color x:Key="HCBackground">#000000</Color>
    <Color x:Key="HCOnSurface">#FFFFFF</Color>
    <Color x:Key="HCOutline">#FFFF00</Color>

    <!-- Brushes للفاتح -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{StaticResource PrimaryHover}"/>
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="{StaticResource PrimaryLight}"/>
    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="{StaticResource PrimaryDark}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource SecondaryColor}"/>
    <SolidColorBrush x:Key="SecondaryHoverBrush" Color="{StaticResource SecondaryHover}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="SurfaceVariantBrush" Color="{StaticResource SurfaceVariant}"/>
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
    <SolidColorBrush x:Key="OnSurfaceBrush" Color="{StaticResource OnSurface}"/>
    <SolidColorBrush x:Key="OnSurfaceVariantBrush" Color="{StaticResource OnSurfaceVariant}"/>
    <SolidColorBrush x:Key="OutlineBrush" Color="{StaticResource OutlineColor}"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}"/>
    <SolidColorBrush x:Key="ErrorLightBrush" Color="{StaticResource ErrorLight}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="WarningLightBrush" Color="{StaticResource WarningLight}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="SuccessLightBrush" Color="{StaticResource SuccessLight}"/>
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}"/>
    <SolidColorBrush x:Key="InfoLightBrush" Color="{StaticResource InfoLight}"/>
    <SolidColorBrush x:Key="WarningColorBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="SuccessColorBrush" Color="{StaticResource SuccessColor}"/>

    <!-- Brushes للمواد -->
    <SolidColorBrush x:Key="SubjectMathBrush" Color="{StaticResource SubjectMath}"/>
    <SolidColorBrush x:Key="SubjectScienceBrush" Color="{StaticResource SubjectScience}"/>
    <SolidColorBrush x:Key="SubjectLanguageBrush" Color="{StaticResource SubjectLanguage}"/>
    <SolidColorBrush x:Key="SubjectHistoryBrush" Color="{StaticResource SubjectHistory}"/>
    <SolidColorBrush x:Key="SubjectArtBrush" Color="{StaticResource SubjectArt}"/>
    <SolidColorBrush x:Key="SubjectPEBrush" Color="{StaticResource SubjectPE}"/>

    <!-- Shadows -->
    <DropShadowEffect x:Key="CardShadow" BlurRadius="8" ShadowDepth="2" Color="#000000" Opacity="0.08" Direction="270"/>
    <DropShadowEffect x:Key="ElevatedShadow" BlurRadius="16" ShadowDepth="4" Color="#000000" Opacity="0.12" Direction="270"/>
    <DropShadowEffect x:Key="ButtonShadow" BlurRadius="4" ShadowDepth="1" Color="#000000" Opacity="0.15" Direction="270"/>

    <!-- Font Family -->
    <FontFamily x:Key="ArabicFont">Segoe UI</FontFamily>

    <!-- RTL Flow Direction -->
    <FlowDirection x:Key="AppFlowDirection">RightToLeft</FlowDirection>
</ResourceDictionary>