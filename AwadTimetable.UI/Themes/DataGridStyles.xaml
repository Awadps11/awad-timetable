<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:fi="clr-namespace:FluentIcons.WPF;assembly=FluentIcons.WPF"
                    xmlns:converters="clr-namespace:AwadTimetable.UI.Converters"
                    xmlns:vm="clr-namespace:AwadTimetable.UI.ViewModels">

    <!-- لون خطوط الشبكة الكلاسيكية (رمادي متوسط كما في aSc) -->
    <SolidColorBrush x:Key="GridLineBrush" Color="#C8C8C8"/>

    <!-- نمط DataGrid للجدول — كلاسيكي مسطح بدون MaterialDesign -->
    <Style x:Key="TimetableDataGrid" TargetType="DataGrid">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="{StaticResource OutlineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="GridLinesVisibility" Value="All"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource GridLineBrush}"/>
        <Setter Property="VerticalGridLinesBrush" Value="{StaticResource GridLineBrush}"/>
        <Setter Property="RowBackground" Value="White"/>
        <Setter Property="AlternatingRowBackground" Value="White"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource TimetableColumnHeader}"/>
        <Setter Property="CellStyle" Value="{StaticResource TimetableCell}"/>
        <Setter Property="RowStyle" Value="{StaticResource TimetableRow}"/>
        <Setter Property="EnableRowVirtualization" Value="True"/>
        <Setter Property="EnableColumnVirtualization" Value="True"/>
        <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>
        <Setter Property="CanUserSortColumns" Value="False"/>
        <Setter Property="CanUserResizeRows" Value="False"/>
        <Setter Property="CanUserResizeColumns" Value="True"/>
        <Setter Property="CanUserReorderColumns" Value="False"/>
        <Setter Property="SelectionMode" Value="Single"/>
        <Setter Property="SelectionUnit" Value="Cell"/>
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="IsReadOnly" Value="False"/>
        <Setter Property="FontFamily" Value="{DynamicResource ArabicFont}"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <!-- نمط رأس العمود — رمادي فاتح ونص داكن (كما في aSc) -->
    <Style x:Key="TimetableColumnHeader" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="#EFEFEF"/>
        <Setter Property="Foreground" Value="#1C1C1C"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontFamily" Value="{DynamicResource ArabicFont}"/>
        <Setter Property="Padding" Value="6,5"/>
        <Setter Property="BorderBrush" Value="{StaticResource GridLineBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Height" Value="30"/>
    </Style>

    <!-- نمط الخلية — مربع مسطح بحدود رمادية -->
    <Style x:Key="TimetableCell" TargetType="DataGridCell">
        <Setter Property="Padding" Value="3"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter
                            VerticalAlignment="Center"
                            HorizontalAlignment="Stretch"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="#D5E8FB"/>
                <Setter Property="BorderBrush" Value="#2563EB"/>
                <Setter Property="BorderThickness" Value="2"/>
                <Setter Property="Foreground" Value="#1C1C1C"/>
            </Trigger>
            <Trigger Property="IsEditing" Value="True">
                <Setter Property="Background" Value="White"/>
                <Setter Property="BorderBrush" Value="#2563EB"/>
                <Setter Property="BorderThickness" Value="2"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- نمط الصف — أبيض مع فصل واضح عند بداية كل فصل دراسي -->
    <Style x:Key="TimetableRow" TargetType="DataGridRow">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="MinHeight" Value="30"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsClassGroupStart}" Value="True">
                <Setter Property="BorderThickness" Value="0,2,0,0"/>
                <Setter Property="BorderBrush" Value="#7A7A7A"/>
            </DataTrigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="#EAF3FD"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#F7FAFF"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- عنصر الحصة الواحدة — مسطح مربع بلا ظل، نص متباين حسب لون الخلفية -->
    <DataTemplate x:Key="LessonItemTemplate" DataType="{x:Type vm:ScheduledLessonViewModel}">
        <Border Background="{Binding CardBackgroundBrush}"
                CornerRadius="0" Margin="0" Padding="2,1"
                ToolTip="{Binding TooltipText}"
                Cursor="Hand">
            <Border.InputBindings>
                <MouseBinding Gesture="LeftDoubleClick" Command="{Binding EditCommand}"/>
            </Border.InputBindings>
            <TextBlock Text="{Binding ChipLine1}"
                       FontWeight="SemiBold" FontSize="10"
                       Foreground="{Binding CardForegroundBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
        </Border>
    </DataTemplate>

    <!-- قوالب خلايا الأيام: كل عمود يعرض حصص يومه فقط (مصفوفة المدرسة) -->
    <DataTemplate x:Key="CellSaturday">
        <ItemsControl ItemsSource="{Binding SaturdayLessons}" ItemTemplate="{StaticResource LessonItemTemplate}" Margin="1"/>
    </DataTemplate>
    <DataTemplate x:Key="CellSunday">
        <ItemsControl ItemsSource="{Binding SundayLessons}" ItemTemplate="{StaticResource LessonItemTemplate}" Margin="1"/>
    </DataTemplate>
    <DataTemplate x:Key="CellMonday">
        <ItemsControl ItemsSource="{Binding MondayLessons}" ItemTemplate="{StaticResource LessonItemTemplate}" Margin="1"/>
    </DataTemplate>
    <DataTemplate x:Key="CellTuesday">
        <ItemsControl ItemsSource="{Binding TuesdayLessons}" ItemTemplate="{StaticResource LessonItemTemplate}" Margin="1"/>
    </DataTemplate>
    <DataTemplate x:Key="CellWednesday">
        <ItemsControl ItemsSource="{Binding WednesdayLessons}" ItemTemplate="{StaticResource LessonItemTemplate}" Margin="1"/>
    </DataTemplate>
    <DataTemplate x:Key="CellThursday">
        <ItemsControl ItemsSource="{Binding ThursdayLessons}" ItemTemplate="{StaticResource LessonItemTemplate}" Margin="1"/>
    </DataTemplate>
    <DataTemplate x:Key="CellFriday">
        <ItemsControl ItemsSource="{Binding FridayLessons}" ItemTemplate="{StaticResource LessonItemTemplate}" Margin="1"/>
    </DataTemplate>

    <!-- قالب خلية فارغة -->
    <DataTemplate x:Key="EmptyCellTemplate">
        <Border Background="Transparent" BorderBrush="Transparent" BorderThickness="0"/>
    </DataTemplate>

    <!-- محول لون المادة -->
    <converters:SubjectColorConverter x:Key="SubjectColorConverter"/>
</ResourceDictionary>
