<UserControl x:Class="AwadTimetable.UI.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="280">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="8">
        <StackPanel>
            <!-- العنوان -->
            <TextBlock Text="نظرة عامة" FontSize="16" FontWeight="Bold"
                       FontFamily="{DynamicResource ArabicFont}" Foreground="{StaticResource OnSurfaceBrush}"
                       Margin="0,0,0,12"/>

            <!-- بطاقة الجدول الحالي -->
            <Border Background="{StaticResource SurfaceVariantBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="الجدول الحالي" FontSize="12" Foreground="{StaticResource OnSurfaceVariantBrush}"
                               FontFamily="{DynamicResource ArabicFont}"/>
                    <TextBlock Text="{Binding CurrentTimetableName, FallbackValue='لا يوجد جدول'}"
                               FontSize="15" FontWeight="Bold" FontFamily="{DynamicResource ArabicFont}"
                               Foreground="{StaticResource OnSurfaceBrush}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding TimetableStatusText, FallbackValue='مسودة'}"
                               FontSize="12" FontFamily="{DynamicResource ArabicFont}"
                               Foreground="{StaticResource OnSurfaceVariantBrush}" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- إحصائيات سريعة -->
            <Border Background="{StaticResource SurfaceVariantBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="إحصائيات" FontSize="12" Foreground="{StaticResource OnSurfaceVariantBrush}"
                               FontFamily="{DynamicResource ArabicFont}" Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,8">
                            <TextBlock Text="{Binding TotalLessonsCount, FallbackValue=0}" FontSize="20" FontWeight="Bold"
                                       Foreground="{StaticResource OnSurfaceBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="حصة" FontSize="11" Foreground="{StaticResource OnSurfaceVariantBrush}"
                                       FontFamily="{DynamicResource ArabicFont}" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,8">
                            <TextBlock Text="{Binding ConflictsCount, FallbackValue=0}" FontSize="20" FontWeight="Bold"
                                       Foreground="{StaticResource WarningColorBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="تضارب" FontSize="11" Foreground="{StaticResource OnSurfaceVariantBrush}"
                                       FontFamily="{DynamicResource ArabicFont}" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0">
                            <TextBlock Text="{Binding QualityScoreText, FallbackValue='0%'}" FontSize="20" FontWeight="Bold"
                                       Foreground="{StaticResource SuccessColorBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="الجودة" FontSize="11" Foreground="{StaticResource OnSurfaceVariantBrush}"
                                       FontFamily="{DynamicResource ArabicFont}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- خطوات البدء -->
            <Border Background="{StaticResource SurfaceVariantBrush}" CornerRadius="8" Padding="12">
                <StackPanel>
                    <TextBlock Text="خطوات البدء" FontSize="12" Foreground="{StaticResource OnSurfaceVariantBrush}"
                               FontFamily="{DynamicResource ArabicFont}" Margin="0,0,0,8"/>
                    <TextBlock Text="1. أضف المعلمين من تبويب المعلمون" FontSize="12" FontFamily="{DynamicResource ArabicFont}"
                               Foreground="{StaticResource OnSurfaceBrush}" TextWrapping="Wrap" Margin="0,2"/>
                    <TextBlock Text="2. أضف المواد من تبويب المواد" FontSize="12" FontFamily="{DynamicResource ArabicFont}"
                               Foreground="{StaticResource OnSurfaceBrush}" TextWrapping="Wrap" Margin="0,2"/>
                    <TextBlock Text="3. أضف الغرف من تبويب الغرف" FontSize="12" FontFamily="{DynamicResource ArabicFont}"
                               Foreground="{StaticResource OnSurfaceBrush}" TextWrapping="Wrap" Margin="0,2"/>
                    <TextBlock Text="4. أضف الفصول من تبويب الفصول" FontSize="12" FontFamily="{DynamicResource ArabicFont}"
                               Foreground="{StaticResource OnSurfaceBrush}" TextWrapping="Wrap" Margin="0,2"/>
                    <TextBlock Text="5. ولّد الجدول: Ctrl+G" FontSize="12" FontFamily="{DynamicResource ArabicFont}"
                               Foreground="{StaticResource OnSurfaceBrush}" TextWrapping="Wrap" Margin="0,2"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
