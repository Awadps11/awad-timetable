<Window x:Class="AwadTimetable.UI.Views.SubstitutionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="البديل والانتظار"
        Width="820" Height="640"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="{DynamicResource ArabicFont}"
        FontSize="13"
        ShowInTaskbar="False">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- شريط الأدوات -->
        <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="False">
            <TextBlock DockPanel.Dock="Right" Text="تاريخ الغياب:" VerticalAlignment="Center" Margin="4,0"/>
            <DatePicker x:Name="DatePicker" Width="140" VerticalAlignment="Center" Margin="4,0"
                        AutomationProperties.Name="تاريخ الغياب"/>
            <Button DockPanel.Dock="Left" Content="⚙ توليد التعيينات" MinWidth="130" Margin="4,0" Padding="10,6"
                    AutomationProperties.Name="توليد التعيينات"
                    Background="{StaticResource PrimaryBrush}" Foreground="White" BorderThickness="0"
                    Click="OnGenerateClick"/>
            <Button DockPanel.Dock="Left" Content="💾 حفظ التعيينات" MinWidth="120" Margin="4,0" Padding="10,6"
                    AutomationProperties.Name="حفظ التعيينات"
                    Background="{StaticResource SecondaryBrush}" Foreground="White" BorderThickness="0"
                    Click="OnSaveClick"/>
            <Button DockPanel.Dock="Left" Content="🗑 حذف تعيينات اليوم" MinWidth="140" Margin="4,0" Padding="10,6"
                    AutomationProperties.Name="حذف تعيينات اليوم"
                    Background="{StaticResource SurfaceVariantBrush}" BorderThickness="0"
                    Click="OnClearClick"/>
            <Button DockPanel.Dock="Left" Content="إغلاق" MinWidth="90" Margin="4,0" Padding="10,6"
                    AutomationProperties.Name="إغلاق نافذة البديل"
                    Background="{StaticResource SurfaceVariantBrush}" BorderThickness="0"
                    Click="OnCloseClick"/>
        </DockPanel>

        <!-- قائمة المعلمين وتحديد الغائبين -->
        <GroupBox Grid.Row="1" Header="المعلمون — حدّد الغائبين (البديل: أول ← ثان ← ثالث)"
                  Padding="6" Margin="0,0,0,8"
                  AutomationProperties.Name="قائمة الغائبين">
            <DataGrid x:Name="TeachersGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      HeadersVisibility="Column"
                      SelectionMode="Single"
                      RowHeight="30"
                      Background="Transparent"
                      BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="غائب" Width="60"
                                            Binding="{Binding IsAbsent, UpdateSourceTrigger=PropertyChanged}"/>
                    <DataGridTextColumn Header="المعلم" Width="180" IsReadOnly="True"
                                        Binding="{Binding FullName}"/>
                    <DataGridTextColumn Header="بديل أول" Width="150" IsReadOnly="True"
                                        Binding="{Binding Sub1Name}"/>
                    <DataGridTextColumn Header="بديل ثان" Width="150" IsReadOnly="True"
                                        Binding="{Binding Sub2Name}"/>
                    <DataGridTextColumn Header="بديل ثالث" Width="150" IsReadOnly="True"
                                        Binding="{Binding Sub3Name}"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <!-- نتائج التعيين -->
        <GroupBox Grid.Row="2" Header="نتائج تعيين البديل"
                  Padding="6"
                  AutomationProperties.Name="نتائج التعيين">
            <DataGrid x:Name="ResultsGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      RowHeight="28"
                      Background="Transparent"
                      BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="الفترة" Width="60" Binding="{Binding Period}"/>
                    <DataGridTextColumn Header="الفصل" Width="140" Binding="{Binding ClassName}"/>
                    <DataGridTextColumn Header="المادة" Width="120" Binding="{Binding SubjectName}"/>
                    <DataGridTextColumn Header="الغائب" Width="150" Binding="{Binding AbsentName}"/>
                    <DataGridTextColumn Header="البديل" Width="150" Binding="{Binding SubstituteName}"/>
                    <DataGridTextColumn Header="الفئة" Width="70" Binding="{Binding TierLabel}"/>
                    <DataGridTextColumn Header="الحالة" Width="90" Binding="{Binding Status}"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <!-- شريط الحالة -->
        <TextBlock Grid.Row="3" x:Name="StatusText" Margin="0,8,0,0"
                   FontFamily="{DynamicResource ArabicFont}" FontSize="12"
                   Foreground="{StaticResource OnSurfaceVariantBrush}"
                   AutomationProperties.Name="حالة التوليد"
                   Text="اختر التاريخ وحدد الغائبين ثم اضغط «توليد التعيينات»."/>
    </Grid>
</Window>
