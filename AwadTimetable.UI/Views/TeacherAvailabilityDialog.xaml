<Window x:Class="AwadTimetable.UI.Views.TeacherAvailabilityDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="التفريغ والندب"
        Height="620" Width="900"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{DynamicResource ArabicFont}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="التفريغ والندب — إغلاق أوقات المعلم" FontSize="18" FontWeight="Bold"
                       Foreground="{DynamicResource PrimaryHueMidBrush}"/>
            <TextBlock Text="اضغط على الخلية لتبديل حالتها: متاح ← إغلاق ملزم (أحمر) ← إغلاق قابل للتجاوز (برتقالي) ← متاح."
                       FontSize="12" TextWrapping="Wrap"
                       Foreground="{StaticResource OnSurfaceVariantBrush}" Margin="0,4,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="المعلم:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="TeacherComboBox" Width="280" DisplayMemberPath="Display"
                      FontFamily="{DynamicResource ArabicFont}"/>
            <TextBlock Text="الصفوف المغلقة إغلاقاً ملزماً لا يُجدَّل فيها أبداً، والقابلة للتجاوز تُستخدم عند الحاجة فقط."
                       VerticalAlignment="Center" Margin="16,0,0,0" FontSize="11"
                       Foreground="{StaticResource OnSurfaceVariantBrush}"/>
        </StackPanel>

        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="10">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Grid x:Name="GridHost"/>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="إغلاق الكل" MinWidth="110" Margin="0,0,8,0" Padding="12,6"
                    Background="{StaticResource SurfaceVariantBrush}" BorderThickness="0"
                    Click="OnBlockAllClick"/>
            <Button Content="تفريغ الكل (مسح)" MinWidth="130" Margin="0,0,8,0" Padding="12,6"
                    Background="{StaticResource SurfaceVariantBrush}" BorderThickness="0"
                    Click="OnClearAllClick"/>
            <Button Content="حفظ" MinWidth="100" Margin="8,0,0,0" Padding="12,6"
                    Background="{StaticResource SecondaryBrush}" Foreground="White" BorderThickness="0"
                    Click="OnSaveClick" IsDefault="True"/>
            <Button Content="إلغاء" MinWidth="100" Margin="8,0,0,0" Padding="12,6"
                    Background="{StaticResource SurfaceVariantBrush}" BorderThickness="0"
                    Click="OnCancelClick"/>
        </StackPanel>
    </Grid>
</Window>
