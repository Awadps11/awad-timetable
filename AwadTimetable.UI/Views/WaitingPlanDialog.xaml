<Window x:Class="AwadTimetable.UI.Views.WaitingPlanDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="خطة الانتظار"
        Height="680" Width="900"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{DynamicResource ArabicFont}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="خطة الانتظار — حدد معلمي كل فئة وعدد حصصهم" FontSize="18" FontWeight="Bold"
                       Foreground="{DynamicResource PrimaryHueMidBrush}"/>
            <TextBlock Text="كل بند: مرحلة + فئة (1/2/3) + معلم + عدد حصص أسبوعية. يمكن للمعلم أن يكون في أكثر من فئة. تُنشأ حصص الانتظار وتُجدول عند التوليد."
                       FontSize="11" TextWrapping="Wrap"
                       Foreground="{StaticResource OnSurfaceVariantBrush}" Margin="0,4,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Background="{StaticResource SurfaceVariantBrush}" CornerRadius="6" Padding="8" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="المرحلة:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="StageComboBox" Width="110" Margin="0,0,12,0" FontFamily="{DynamicResource ArabicFont}"/>

                <TextBlock Text="الفئة:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="TierComboBox" Width="80" Margin="0,0,12,0">
                    <ComboBoxItem Content="1" Tag="1" IsSelected="True"/>
                    <ComboBoxItem Content="2" Tag="2"/>
                    <ComboBoxItem Content="3" Tag="3"/>
                </ComboBox>

                <TextBlock Text="المعلم:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="TeacherComboBox" Width="220" Margin="0,0,12,0"
                          DisplayMemberPath="Display" FontFamily="{DynamicResource ArabicFont}"/>

                <TextBlock Text="عدد الحصص:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox x:Name="PeriodsTextBox" Width="60" Text="2" TextAlignment="Center"
                         FlowDirection="LeftToRight" Margin="0,0,12,0"/>

                <Button Content="إضافة" MinWidth="90" Padding="12,6" Click="OnAddClick"
                        Background="{StaticResource PrimaryBrush}" Foreground="White" BorderThickness="0"/>
            </StackPanel>
        </Border>

        <DataGrid x:Name="PlanGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" GridLinesVisibility="All" RowHeaderWidth="0"
                  FontFamily="{DynamicResource ArabicFont}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="المرحلة" Binding="{Binding Stage}" Width="110"/>
                <DataGridTextColumn Header="الفئة" Binding="{Binding Tier}" Width="60"/>
                <DataGridTextColumn Header="المعلم" Binding="{Binding TeacherName}" Width="*"/>
                <DataGridTextColumn Header="عدد الحصص" Binding="{Binding Periods}" Width="90"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock x:Name="SummaryText" Grid.Row="3" Margin="0,8,0,0" FontSize="11"
                   TextWrapping="Wrap" Foreground="{StaticResource OnSurfaceVariantBrush}"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="حذف المحدد" MinWidth="110" Margin="0,0,8,0" Padding="12,6" Click="OnRemoveClick"
                    Background="{StaticResource SurfaceVariantBrush}" BorderThickness="0"/>
            <Button Content="توليد حصص الانتظار" MinWidth="170" Margin="0,0,8,0" Padding="12,6" Click="OnGenerateClick"
                    Background="{StaticResource SecondaryBrush}" Foreground="White" BorderThickness="0"/>
            <Button Content="إغلاق" MinWidth="100" Padding="12,6" Click="OnCloseClick"
                    Background="{StaticResource SurfaceVariantBrush}" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
