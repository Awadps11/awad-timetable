<UserControl x:Class="AwadTimetable.UI.Views.ClassesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="280">

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- العنوان -->
        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <Button DockPanel.Dock="Left" Content="⟳" Command="{Binding RefreshCommand}"
                    Style="{StaticResource MaterialDesignFlatButton}" Width="32" Height="32"
                    ToolTip="تحديث"/>
            <TextBlock Text="الفصول" FontSize="16" FontWeight="Bold"
                       FontFamily="{DynamicResource ArabicFont}"
                       Foreground="{StaticResource OnSurfaceBrush}"/>
        </DockPanel>

        <!-- نموذج الإضافة -->
        <Border Grid.Row="1" Background="{StaticResource SurfaceVariantBrush}"
                CornerRadius="6" Padding="8" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="اسم الفصل * (مثال: 1/أ)" FontSize="11" FontWeight="SemiBold"
                           FontFamily="{DynamicResource ArabicFont}"
                           Foreground="{StaticResource OnSurfaceVariantBrush}" Margin="0,0,0,2"/>
                <TextBox Style="{StaticResource ArabicTextBox}"
                         Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,6"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="الصف:" VerticalAlignment="Center" FontFamily="{DynamicResource ArabicFont}" FontSize="12" Margin="0,0,8,0"/>
                    <TextBox Style="{StaticResource ArabicTextBox}" Width="50" TextAlignment="Center" FlowDirection="LeftToRight"
                             Text="{Binding NewGradeLevel, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,12,0"/>
                    <TextBlock Text="الشعبة:" VerticalAlignment="Center" FontFamily="{DynamicResource ArabicFont}" FontSize="12" Margin="0,0,8,0"/>
                    <TextBox Style="{StaticResource ArabicTextBox}" Width="40" TextAlignment="Center"
                             MaxLength="1"
                             Text="{Binding NewSection, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,12,0"/>
                    <TextBlock Text="طلاب:" VerticalAlignment="Center" FontFamily="{DynamicResource ArabicFont}" FontSize="12" Margin="0,0,8,0"/>
                    <TextBox Style="{StaticResource ArabicTextBox}" Width="50" TextAlignment="Center" FlowDirection="LeftToRight"
                             Text="{Binding NewStudentCount, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <TextBlock Text="الاختصار (للعرض والطباعة)" FontSize="11" FontWeight="SemiBold"
                           FontFamily="{DynamicResource ArabicFont}"
                           Foreground="{StaticResource OnSurfaceVariantBrush}" Margin="0,0,0,2"/>
                <TextBox Style="{StaticResource ArabicTextBox}"
                         Text="{Binding NewShortName, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,8"/>
                <Button Content="➕ إضافة فصل"
                        Command="{Binding AddCommand}"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        FontFamily="{DynamicResource ArabicFont}" FontSize="13"
                        HorizontalAlignment="Stretch"/>
            </StackPanel>
        </Border>

        <!-- القائمة -->
        <ListBox Grid.Row="2"
                 x:Name="ClassList"
                 SelectionMode="Extended"
                 ItemsSource="{Binding Classes}"
                 SelectedItem="{Binding SelectedClass}"
                 Background="Transparent"
                 BorderThickness="0"
                 FontFamily="{DynamicResource ArabicFont}" FontSize="13">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource MaterialDesignListBoxItem}">
                    <Setter Property="Padding" Value="8,6"/>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <TextBlock Text="{Binding FullName}" FontWeight="Medium"/>
                        <TextBlock FontSize="11" Foreground="{StaticResource OnSurfaceVariantBrush}">
                            <Run Text="الاختصار: "/><Run Text="{Binding DisplayShortName, Mode=OneWay}"/>
                            <Run Text="  —  "/><Run Text="{Binding StudentCount, Mode=OneWay}"/><Run Text=" طالب"/>
                        </TextBlock>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- تعديل المحدد + الحذف -->
        <StackPanel Grid.Row="3" Margin="0,8,0,0">
            <Border Background="{StaticResource SurfaceVariantBrush}" CornerRadius="6" Padding="8" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="تعديل الفصل المحدد" FontSize="11" FontWeight="SemiBold"
                               FontFamily="{DynamicResource ArabicFont}"
                               Foreground="{StaticResource OnSurfaceVariantBrush}" Margin="0,0,0,4"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="الاختصار:" VerticalAlignment="Center" FontFamily="{DynamicResource ArabicFont}" FontSize="12" Margin="0,0,8,0"/>
                        <TextBox Style="{StaticResource ArabicTextBox}" Width="90"
                                 Text="{Binding EditShortName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,12,0"/>
                        <TextBlock Text="عدد الطلاب:" VerticalAlignment="Center" FontFamily="{DynamicResource ArabicFont}" FontSize="12" Margin="0,0,8,0"/>
                        <TextBox Style="{StaticResource ArabicTextBox}" Width="50" TextAlignment="Center" FlowDirection="LeftToRight"
                                 Text="{Binding EditStudentCount, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <Button Content="تطبيق على المحدد"
                            Command="{Binding ApplyEditCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            FontFamily="{DynamicResource ArabicFont}" FontSize="12"
                            HorizontalAlignment="Stretch"/>
                </StackPanel>
            </Border>
            <WrapPanel Margin="0,0,0,6">
                <Button Content="تحديد الكل" Click="OnSelectAll" Margin="0,0,6,4" Padding="8,3"
                        Style="{StaticResource MaterialDesignOutlinedButton}" FontSize="11" FontFamily="{DynamicResource ArabicFont}"/>
                <Button Content="إلغاء التحديد" Click="OnClearSelection" Margin="0,0,6,4" Padding="8,3"
                        Style="{StaticResource MaterialDesignOutlinedButton}" FontSize="11" FontFamily="{DynamicResource ArabicFont}"/>
                <Button Content="نسخ المحدد" Click="OnCopySelected" Margin="0,0,6,4" Padding="8,3"
                        Style="{StaticResource MaterialDesignOutlinedButton}" FontSize="11" FontFamily="{DynamicResource ArabicFont}"/>
                <Button Content="تصدير المحدد" Click="OnExportSelected" Margin="0,0,6,4" Padding="8,3"
                        Style="{StaticResource MaterialDesignOutlinedButton}" FontSize="11" FontFamily="{DynamicResource ArabicFont}"/>
            </WrapPanel>
            <Button Content="🗑 حذف المحدد"
                    Click="OnDeleteSelected"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    FontFamily="{DynamicResource ArabicFont}" FontSize="12"
                    Foreground="Red"
                    HorizontalAlignment="Stretch"/>
        </StackPanel>

        <!-- مؤشر التحميل -->
        <ProgressBar Grid.Row="2" IsIndeterminate="True"
                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                     Height="4" VerticalAlignment="Top" Panel.ZIndex="1"/>
    </Grid>
</UserControl>
