<Window x:Class="AwadTimetable.UI.Views.SetupWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="معالج إعداد الجدول"
        Height="560" Width="760" MinHeight="500" MinWidth="680"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{DynamicResource ArabicFont}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="إعداد الجدول خطوة بخطوة" FontSize="22" FontWeight="Bold"
                       Foreground="{DynamicResource PrimaryHueMidBrush}"/>
            <TextBlock Text="تنقّل بين الخطوات، وافتح أدوات التطبيق الحالية دون إغلاق هذا المعالج. يُحفظ موضعك تلقائياً لكل جدول."
                       FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0"
                       Foreground="{StaticResource OnSurfaceVariantBrush}"/>
        </StackPanel>

        <ProgressBar x:Name="StepProgress" Grid.Row="1" Height="6" Minimum="0" Maximum="7"
                     Margin="0,0,0,16"/>

        <Border Grid.Row="2" Padding="22" CornerRadius="8"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource OutlineBrush}" BorderThickness="1">
            <StackPanel VerticalAlignment="Top">
                <TextBlock x:Name="StepNumberText" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                <TextBlock x:Name="StepTitleText" FontSize="20" FontWeight="Bold" Margin="0,5,0,10"/>
                <TextBlock x:Name="StepDescriptionText" FontSize="14" TextWrapping="Wrap"
                           LineHeight="26"/>
                <Border Margin="0,18,0,0" Padding="12" CornerRadius="6"
                        Background="White" BorderBrush="{StaticResource OutlineBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="حالة هذه الخطوة" FontSize="12" FontWeight="Bold"/>
                        <TextBlock x:Name="StepSummaryText" FontSize="12" TextWrapping="Wrap"
                                   Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
                <TextBlock x:Name="ActionStatusText" FontSize="12" TextWrapping="Wrap"
                           Margin="0,12,0,0" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left">
                <Button x:Name="OpenStepButton" Content="فتح الخطوة في التطبيق"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        MinWidth="170" Margin="0,0,8,0" Click="OnOpenStepClick"/>
                <Button x:Name="AvailabilityButton" Content="إعداد تفريغ المعلمين"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        MinWidth="150" Margin="0,0,8,0" Click="OnAvailabilityClick"/>
                <Button x:Name="AssignmentsLessonsButton" Content="إنشاء حصص الإسنادات"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        MinWidth="155" Click="OnAssignmentsLessonsClick"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BackButton" Content="السابق" MinWidth="90" Margin="0,0,8,0"
                        Style="{StaticResource MaterialDesignFlatButton}" Click="OnBackClick"/>
                <Button x:Name="NextButton" Content="التالي" MinWidth="100" Margin="0,0,8,0"
                        Style="{StaticResource MaterialDesignRaisedButton}" Click="OnNextClick"/>
                <Button x:Name="CloseButton" Content="إغلاق" MinWidth="90"
                        Style="{StaticResource MaterialDesignFlatButton}" Click="OnCloseClick"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>