<Window x:Class="AwadTimetable.UI.Views.CopyLessonsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="نسخ/نقل الحصص"
        Width="480" Height="320"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="Segoe UI"
        FontSize="14"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,10"
                   Foreground="{StaticResource OnSurfaceVariantBrush}"
                   Text="انسح حصص فصل كامل إلى فصل آخر (الأقسام المتوازية)، أو انقل حصص معلم كامل إلى معلم آخر (بديل)."/>

        <Grid Grid.Row="1" Margin="0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="الوضع:" VerticalAlignment="Center"/>
            <ComboBox Grid.Column="1" x:Name="ModeComboBox" SelectionChanged="OnModeChanged">
                <ComboBoxItem Content="نسخ حصص فصل" Tag="class" IsSelected="True"/>
                <ComboBoxItem Content="نقل حصص معلم" Tag="teacher"/>
            </ComboBox>
        </Grid>

        <Grid Grid.Row="2" Margin="0,8,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" x:Name="SourceLabel" Text="الفصل المصدر:" VerticalAlignment="Center"/>
            <ComboBox Grid.Column="1" x:Name="SourceComboBox" DisplayMemberPath="FullName"/>
        </Grid>

        <Grid Grid.Row="3" Margin="0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" x:Name="TargetLabel" Text="الفصل الهدف:" VerticalAlignment="Center"/>
            <ComboBox Grid.Column="1" x:Name="TargetComboBox" DisplayMemberPath="FullName"/>
        </Grid>

        <CheckBox Grid.Row="4" x:Name="ReplaceCheckBox" Content="استبدال حصص الفصل الهدف الموجودة (بدلاً من الإضافة)"
                  IsChecked="True" VerticalAlignment="Top" Margin="0,10,0,0"/>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
            <Button Content="تنفيذ" MinWidth="100" Margin="8,0" Padding="12,7"
                    AutomationProperties.Name="تنفيذ النسخ"
                    Background="{StaticResource SecondaryBrush}" Foreground="White" BorderThickness="0"
                    Click="OnExecuteClick"/>
            <Button Content="إلغاء" MinWidth="100" Margin="8,0" Padding="12,7"
                    AutomationProperties.Name="إلغاء النسخ"
                    Background="{StaticResource SurfaceVariantBrush}" BorderThickness="0"
                    Click="OnCancelClick"/>
        </StackPanel>
    </Grid>
</Window>
