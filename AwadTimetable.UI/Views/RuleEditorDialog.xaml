<Window x:Class="AwadTimetable.UI.Views.RuleEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="محرر القاعدة"
        Width="640" Height="700"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{DynamicResource ArabicFont}"
        FontSize="13">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock x:Name="HeaderText" Text="إضافة قاعدة" FontSize="18" FontWeight="Bold"
                       Foreground="{DynamicResource PrimaryHueMidBrush}"/>
            <TextBlock Text="اختر نوع القاعدة ثم الهدف؛ تظهر الحقول المناسبة تلقائياً. الأولوية «صلب» تمنع الحل عند التعارض."
                       FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource OnSurfaceVariantBrush}"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="نوع القاعدة" FontWeight="SemiBold" Margin="0,0,0,2"/>
                <ComboBox x:Name="KindCombo" Margin="0,0,0,8"
                          DisplayMemberPath="Text" SelectedValuePath="Value"
                          SelectionChanged="OnKindChanged"/>

                <TextBlock Text="النطاق" FontWeight="SemiBold" Margin="0,0,0,2"/>
                <ComboBox x:Name="ScopeCombo" Margin="0,0,0,8"
                          DisplayMemberPath="Text" SelectedValuePath="Value"
                          SelectionChanged="OnScopeChanged"/>

                <TextBlock x:Name="TargetLabel" Text="الهدف" FontWeight="SemiBold" Margin="0,0,0,2"/>
                <ComboBox x:Name="TargetCombo" Margin="0,0,0,8"
                          DisplayMemberPath="Name" SelectedValuePath="Id"/>

                <StackPanel x:Name="SecondTargetPanel" Visibility="Collapsed">
                    <TextBlock x:Name="SecondTargetLabel" Text="المادة الثانية / القاعة" FontWeight="SemiBold" Margin="0,0,0,2"/>
                    <ComboBox x:Name="SecondTargetCombo" Margin="0,0,0,8"
                              DisplayMemberPath="Name" SelectedValuePath="Id"/>
                </StackPanel>

                <TextBlock Text="الأولوية" FontWeight="SemiBold" Margin="0,0,0,2"/>
                <ComboBox x:Name="PriorityCombo" Margin="0,0,0,8"
                          DisplayMemberPath="Text" SelectedValuePath="Value"/>

                <TextBlock Text="العنوان (اختياري — يُولَّد تلقائياً)" FontWeight="SemiBold" Margin="0,0,0,2"/>
                <TextBox x:Name="TitleBox" Margin="0,0,0,8"/>

                <CheckBox x:Name="EnabledCheck" Content="القاعدة مفعّلة" IsChecked="True" Margin="0,0,0,10"/>

                <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="10">
                    <StackPanel>
                        <TextBlock Text="معاملات القاعدة" FontWeight="Bold" Margin="0,0,0,6"/>
                        <StackPanel x:Name="ParamsPanel"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="حفظ" MinWidth="110" Margin="0,0,8,0" IsDefault="True"
                    Click="OnSaveClick" Style="{StaticResource MaterialDesignRaisedButton}"/>
            <Button Content="إلغاء" MinWidth="100" IsCancel="True"
                    Style="{StaticResource MaterialDesignFlatButton}"/>
        </StackPanel>
    </Grid>
</Window>
