<UserControl x:Class="AwadTimetable.UI.Views.TeachersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="280">

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- العنوان -->
        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <Button DockPanel.Dock="Left" Content="⟳" Command="{Binding RefreshCommand}"
                    Style="{StaticResource MaterialDesignFlatButton}" Width="32" Height="32"
                    ToolTip="تحديث"/>
            <TextBlock Text="المعلمون" FontSize="16" FontWeight="Bold"
                       FontFamily="{DynamicResource ArabicFont}"
                       Foreground="{StaticResource OnSurfaceBrush}"/>
        </DockPanel>

        <!-- نموذج الإضافة: الاسم المختصر فقط -->
        <Border Grid.Row="1" Background="{StaticResource SurfaceVariantBrush}"
                CornerRadius="6" Padding="8" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="اسم المعلم (المختصر) *" FontSize="11" FontWeight="SemiBold"
                           FontFamily="{DynamicResource ArabicFont}"
                           Foreground="{StaticResource OnSurfaceVariantBrush}" Margin="0,0,0,2"/>
                <TextBox Style="{StaticResource ArabicTextBox}"
                         Text="{Binding NewDisplayName, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="اسم المعلم المختصر"
                         Margin="0,0,0,8"/>
                <TextBlock Text="يُخصص لكل معلم لون تلقائياً غير مستخدم، ويمكن تغييره من المظهر أدناه."
                           FontSize="10" TextWrapping="Wrap"
                           FontFamily="{DynamicResource ArabicFont}"
                           Foreground="{StaticResource OnSurfaceVariantBrush}" Margin="0,0,0,8"/>
                <Button Content="➕ إضافة معلم"
                        Command="{Binding AddCommand}"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        FontFamily="{DynamicResource ArabicFont}" FontSize="13"
                        HorizontalAlignment="Stretch"/>
                <TextBlock Text="استيراد من ملف" FontSize="11" FontWeight="SemiBold"
                           FontFamily="{DynamicResource ArabicFont}"
                           Foreground="{StaticResource OnSurfaceVariantBrush}" Margin="0,10,0,4"/>
                <Button Content="Excel / CSV"
                        Command="{Binding ImportFromFileCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        FontFamily="{DynamicResource ArabicFont}" FontSize="12"
                        Margin="0,0,0,4"
                        HorizontalAlignment="Stretch"/>
                <Button Content="من صورة (ذكاء اصطناعي)"
                        Command="{Binding ImportFromImageCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        FontFamily="{DynamicResource ArabicFont}" FontSize="12"
                        HorizontalAlignment="Stretch"/>
            </StackPanel>
        </Border>

        <!-- القائمة -->
        <ListBox Grid.Row="2"
                 x:Name="TeacherList"
                 SelectionMode="Extended"
                 ItemsSource="{Binding Teachers}"
                 SelectedItem="{Binding SelectedTeacher}"
                 Background="Transparent"
                 BorderThickness="0"
                 FontFamily="{DynamicResource ArabicFont}" FontSize="13"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource MaterialDesignListBoxItem}">
                    <Setter Property="Padding" Value="8,6"/>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="16" Height="16" CornerRadius="4" Margin="0,0,8,0"
                                BorderThickness="1" BorderBrush="#33000000"
                                Background="{Binding CustomColorHex, Converter={StaticResource SubjectColorConverter}}"/>
                        <TextBlock Text="{Binding DisplayShortName}" FontWeight="Medium" VerticalAlignment="Center"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- المظهر: الاسم المختصر واللون -->
        <Border Grid.Row="3" Background="{StaticResource SurfaceVariantBrush}"
                CornerRadius="6" Padding="8" Margin="0,8,0,0"
                AutomationProperties.Name="مظهر المعلم">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedTeacher}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <TextBlock Text="المظهر (اسم مختصر ولون)" FontWeight="Bold" FontSize="12"
                           FontFamily="{DynamicResource ArabicFont}" Margin="0,0,0,4"/>
                <TextBlock Text="الاسم المختصر" FontSize="11" FontWeight="SemiBold"
                           FontFamily="{DynamicResource ArabicFont}"
                           Foreground="{StaticResource OnSurfaceVariantBrush}" Margin="0,0,0,2"/>
                <TextBox Style="{StaticResource ArabicTextBox}"
                         Text="{Binding EditShortName, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="الاسم المختصر للمعلم"
                         Margin="0,0,0,6"/>
                <TextBlock Text="اللون (اختر لوناً غير مستخدم)" FontSize="11" FontWeight="SemiBold"
                           FontFamily="{DynamicResource ArabicFont}"
                           Foreground="{StaticResource OnSurfaceVariantBrush}" Margin="0,0,0,2"/>
                <DockPanel Margin="0,0,0,6">
                    <Border DockPanel.Dock="Left" Width="28" Height="24" CornerRadius="4"
                            Margin="4,0,0,0" BorderThickness="1"
                            BorderBrush="{StaticResource OnSurfaceVariantBrush}"
                            Background="{Binding EditColorHex, Converter={StaticResource SubjectColorConverter}}"/>
                    <TextBox Style="{StaticResource ArabicTextBox}"
                             Text="{Binding EditColorHex, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="لون المعلم"
                             VerticalContentAlignment="Center"/>
                </DockPanel>
                <Button Content="💾 حفظ المظهر"
                        Command="{Binding SaveAppearanceCommand}"
                        AutomationProperties.Name="حفظ مظهر المعلم"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        FontFamily="{DynamicResource ArabicFont}" FontSize="12"
                        HorizontalAlignment="Stretch"/>
            </StackPanel>
        </Border>

        <!-- أزرار السفلية (تحديد متعدد) -->
        <StackPanel Grid.Row="4" Margin="0,8,0,0">
            <WrapPanel Margin="0,0,0,6">
                <Button Content="تحديد الكل" Click="OnSelectAll" Margin="0,0,6,4" Padding="8,3"
                        Style="{StaticResource MaterialDesignOutlinedButton}" FontSize="11"
                        FontFamily="{DynamicResource ArabicFont}"/>
                <Button Content="إلغاء التحديد" Click="OnClearSelection" Margin="0,0,6,4" Padding="8,3"
                        Style="{StaticResource MaterialDesignOutlinedButton}" FontSize="11"
                        FontFamily="{DynamicResource ArabicFont}"/>
                <Button Content="نسخ المحدد" Click="OnCopySelected" Margin="0,0,6,4" Padding="8,3"
                        Style="{StaticResource MaterialDesignOutlinedButton}" FontSize="11"
                        FontFamily="{DynamicResource ArabicFont}"/>
                <Button Content="تصدير المحدد" Click="OnExportSelected" Margin="0,0,6,4" Padding="8,3"
                        Style="{StaticResource MaterialDesignOutlinedButton}" FontSize="11"
                        FontFamily="{DynamicResource ArabicFont}"/>
            </WrapPanel>
            <Button Content="🗑 حذف المحدد"
                    Click="OnDeleteSelected"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    FontFamily="{DynamicResource ArabicFont}" FontSize="12"
                    Foreground="Red"
                    HorizontalAlignment="Stretch"/>
        </StackPanel>

        <!-- مؤشر التحميل -->
        <ProgressBar Grid.Row="2" IsIndeterminate="True" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                     Height="4" VerticalAlignment="Top" Panel.ZIndex="1"/>
    </Grid>
</UserControl>
