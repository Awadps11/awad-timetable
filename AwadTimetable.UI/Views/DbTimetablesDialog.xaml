<Window x:Class="AwadTimetable.UI.Views.DbTimetablesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="فتح جدول من قاعدة البيانات"
        Width="860" Height="440"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        FontFamily="Segoe UI, Arial"
        FontSize="14">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="اختر جدولًا محفوظًا لفتحه (تُستبدل النسخة الحالية في العرض):"
                   Margin="0,0,0,8" FontWeight="Bold"/>

        <ListView Grid.Row="1"
                  x:Name="TimetablesList"
                  MouseDoubleClick="OpenButton_Click"
                  SelectionMode="Single">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="اسم الجدول" Width="190"
                                    DisplayMemberBinding="{Binding Name}"/>
                    <GridViewColumn Header="المدرسة" Width="150"
                                    DisplayMemberBinding="{Binding SchoolName}"/>
                    <GridViewColumn Header="السنة الدراسية" Width="120"
                                    DisplayMemberBinding="{Binding YearLabel}"/>
                    <GridViewColumn Header="الفصل" Width="60"
                                    DisplayMemberBinding="{Binding Term}"/>
                    <GridViewColumn Header="الحصة" Width="70"
                                    DisplayMemberBinding="{Binding LessonsCount}"/>
                    <GridViewColumn Header="الحالة" Width="90"
                                    DisplayMemberBinding="{Binding Status}"/>
                    <GridViewColumn Header="آخر حفظ" Width="130"
                                    DisplayMemberBinding="{Binding UpdatedLabel}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <DockPanel Grid.Row="2" Margin="0,12,0,0" LastChildFill="False">
            <TextBlock x:Name="CountText" DockPanel.Dock="Right"
                       VerticalAlignment="Center" Opacity="0.7"/>
            <StackPanel Orientation="Horizontal">
                <Button Content="فتح" MinWidth="90" Margin="0,0,8,0" FontWeight="Bold"
                        IsDefault="True" Click="OpenButton_Click"
                        Style="{StaticResource MaterialDesignRaisedButton}"/>
                <Button Content="حذف" MinWidth="90" Margin="0,0,8,0"
                        Click="DeleteButton_Click"
                        Style="{StaticResource MaterialDesignOutlinedButton}"/>
                <Button Content="إلغاء" MinWidth="90" IsCancel="True"
                        Style="{StaticResource MaterialDesignFlatButton}"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
