<Window x:Class="AwadTimetable.UI.Views.SupervisionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="الإشراف (الفسح)"
        Height="660" Width="820"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{DynamicResource ArabicFont}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="الإشراف (الفسح)" FontSize="18" FontWeight="Bold"
                       Foreground="{DynamicResource PrimaryHueMidBrush}"/>
            <TextBlock Text="يوزّع فترات الاستراحة على القاعات ويكلّف معلماً غير مشغول بكل قاعة."
                       FontSize="11" TextWrapping="Wrap"
                       Foreground="{StaticResource OnSurfaceVariantBrush}" Margin="0,4,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="التاريخ:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <DatePicker x:Name="DatePicker" Width="160" Margin="0,0,16,0"/>
            <Button Content="توليد الإشراف" MinWidth="140" Padding="12,6" Click="OnGenerateClick"
                    Background="{StaticResource PrimaryBrush}" Foreground="White" BorderThickness="0"/>
            <TextBlock x:Name="SummaryText" VerticalAlignment="Center" Margin="16,0,0,0" FontSize="11"
                       Foreground="{StaticResource OnSurfaceVariantBrush}"/>
        </StackPanel>

        <DataGrid x:Name="ResultsGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" GridLinesVisibility="All" RowHeaderWidth="0"
                  FontFamily="{DynamicResource ArabicFont}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="اليوم" Binding="{Binding DayText}" Width="100"/>
                <DataGridTextColumn Header="الفترة" Binding="{Binding Period}" Width="70"/>
                <DataGridTextColumn Header="القاعة" Binding="{Binding RoomName}" Width="*"/>
                <DataGridTextColumn Header="المشرف" Binding="{Binding SupervisorName}" Width="*"/>
                <DataGridTextColumn Header="الحالة" Binding="{Binding Status}" Width="110"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="3" Margin="0,8,0,0" FontSize="11" TextWrapping="Wrap"
                   Foreground="{StaticResource OnSurfaceVariantBrush}"
                   Text="ملاحظة: يُوزّع الإشراف على فترات الاستراحة المعرّفة في توقيت الفترات. إن لم تظهر نتائج، أضف استراحة من «توقيت الفترات»."/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="إغلاق" MinWidth="100" Padding="12,6" Click="OnCloseClick"
                    Background="{StaticResource SurfaceVariantBrush}" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
