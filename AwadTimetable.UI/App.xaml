<Application x:Class="AwadTimetable.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AwadTimetable.UI"
             xmlns:vm="clr-namespace:AwadTimetable.UI.ViewModels"
             xmlns:views="clr-namespace:AwadTimetable.UI.Views"
             xmlns:converters="clr-namespace:AwadTimetable.UI.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- ألوان التطبيق المخصصة -->
                <ResourceDictionary Source="Themes/Colors.xaml" />
                <!-- أنماط كلاسيكية بلمسة Windows الأصلية -->
                <ResourceDictionary Source="Themes/ClassicStyles.xaml" />
                <ResourceDictionary Source="Themes/DataGridStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- محولات مشتركة -->
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
            <converters:CountToVisibilityConverter x:Key="CountToVisibilityConverter"/>
            <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
            <converters:RoleToBrushConverter x:Key="RoleToBrush"/>
            <converters:BoolToBrushConverter x:Key="BoolToBrushConverter"/>
            <converters:BoolToHorizontalAlignmentConverter x:Key="BoolToHorizontalAlignmentConverter"/>
            <converters:EnumToBooleanConverter x:Key="EnumToBooleanConverter"/>
        <converters:SubjectColorConverter x:Key="SubjectColorConverter"/>

            <!-- قوالب عرض (ViewModel → View) -->
            <DataTemplate DataType="{x:Type vm:AIChatPanelViewModel}">
                <views:AIChatPanel/>
            </DataTemplate>

            <!-- ViewModel Locator -->
            <vm:ViewModelLocator x:Key="Locator" />

            <!-- إعدادات الخط العربي الافتراضي (مُعرَّف في Themes/Colors.xaml) -->
            <Style TargetType="TextBlock" x:Key="ArabicTextBlock">
                <Setter Property="FontFamily" Value="{DynamicResource ArabicFont}" />
                <Setter Property="FlowDirection" Value="RightToLeft" />
                <Setter Property="FontSize" Value="13" />
            </Style>

            <!-- نمط الأزرار العربية -->
            <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}" x:Key="ArabicButton">
                <Setter Property="FontFamily" Value="{DynamicResource ArabicFont}" />
                <Setter Property="FlowDirection" Value="RightToLeft" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Padding" Value="12,6" />
            </Style>

            <!-- نمط حقول الإدخال -->
            <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignTextBox}" x:Key="ArabicTextBox">
                <Setter Property="FontFamily" Value="{DynamicResource ArabicFont}" />
                <Setter Property="FlowDirection" Value="RightToLeft" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Padding" Value="8,4" />
            </Style>

            <Style TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignComboBox}" x:Key="ArabicComboBox">
                <Setter Property="FontFamily" Value="{DynamicResource ArabicFont}" />
                <Setter Property="FlowDirection" Value="RightToLeft" />
                <Setter Property="FontSize" Value="13" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
